{
  "name": "qihang-ai-desktop",
  "version": "0.9.0",
  "description": "启航AI工作台",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run compile:electron && concurrently \"vite\" \"electron . --dev\"",
    "electron:build": "vite build && npm run compile:electron && npx electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@opencode-ai/sdk": "1.19.3",
    "better-sqlite3": "^12.11.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^15.0.0",
    "node-cron": "^4.6.0",
    "ollama": "^0.5.14",
    "pinia": "^3.0.0",
    "pptxgenjs": "^4.0.1",
    "typebox": "^1.1.38",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^25.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.qihang.qihang-ai-desktop",
    "productName": "启航AI工作台",
    "icon": "build/icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*",
      "package.json",
      "LICENSE",
      "!config.json",
      "!nul",
      "!node_modules/@google/**",
      "!node_modules/@anthropic-ai/**",
      "!node_modules/@aws/**",
      "!node_modules/@aws-sdk/**",
      "!node_modules/@smithy/**",
      "!node_modules/@stablelib/**",
      "!node_modules/@babel/**",
      "!node_modules/gaxios/**",
      "!node_modules/google-auth-library/**",
      "!node_modules/p-retry/**",
      "!node_modules/node-fetch/**",
      "!node_modules/fetch-blob/**",
      "!node_modules/formdata-polyfill/**",
      "!node_modules/web-streams-polyfill/**",
      "!node_modules/json-schema-to-ts/**",
      "!node_modules/zod-to-json-schema/**",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.cts",
      "!node_modules/**/*.d.mts",
      "!node_modules/**/*.map",
      "!node_modules/**/*.tsbuildinfo",
      "!node_modules/**/README.md",
      "!node_modules/**/CHANGELOG.md",
      "!node_modules/**/example/**",
      "!node_modules/**/examples/**",
      "!node_modules/**/benchmark/**",
      "!node_modules/**/benchmarks/**",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/__tests__/**",
      "!node_modules/**/__mocks__/**",
      "!node_modules/**/*.pdb",
      "!node_modules/**/*.iobj",
      "!node_modules/**/*.ipdb",
      "!node_modules/**/*.exp",
      "!node_modules/**/*.lib",
      "!node_modules/**/*.obj",
      "!node_modules/**/*.o",
      "!node_modules/**/*.a",
      "!node_modules/**/*.vcxproj",
      "!node_modules/**/*.vcxproj.filters",
      "!node_modules/**/*.sln",
      "!node_modules/**/*.gypi",
      "!node_modules/**/*.gyp",
      "!node_modules/**/Makefile",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/openai/resources/**/*.md",
      "!node_modules/@larksuiteoapi/node-sdk/es/**",
      "!node_modules/@larksuiteoapi/node-sdk/src/**",
      "!node_modules/vue/**",
      "!node_modules/@vue/**",
      "!node_modules/pinia/**",
      "!node_modules/vue-router/**",
      "!node_modules/marked/**",
      "!node_modules/highlight.js/**",
      "!node_modules/katex/**",
      "!node_modules/node-gyp/**"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "启航AI工作台",
      "artifactName": "qihang-ai-desktop-${version}-setup.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
