{
  "name": "qihang-ai-desktop",
  "version": "0.8.0",
  "description": "启航AI工作台",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run compile:electron && concurrently \"vite\" \"electron . --dev\"",
    "electron:build": "vite build && npm run compile:electron && npx electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.3",
    "@electron/rebuild": "^4.2.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "better-sqlite3": "^12.11.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^15.0.0",
    "mysql2": "^3.23.2",
    "node-cron": "^4.6.0",
    "ollama": "^0.5.14",
    "pinia": "^3.0.0",
    "pptxgenjs": "^4.0.1",
    "simple-git": "^3.36.0",
    "typebox": "^1.1.38",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.qihang.qihang-ai-desktop",
    "productName": "启航AI工作台",
    "icon": "build/icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*",
      "package.json",
      "LICENSE",
      "!config.json",
      "!nul",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/@google/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/@mistralai/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/@anthropic-ai/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/@aws-sdk/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/@smithy/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/@opentelemetry/semantic-conventions/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/protobufjs/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/p-retry/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/google-auth-library/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/gaxios/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/node-fetch/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/fetch-blob/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/formdata-polyfill/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/web-streams-polyfill/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/zod-to-json-schema/**",
      "!node_modules/@earendil-works/pi-coding-agent/node_modules/json-schema-to-ts/**"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/electron/worker/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "启航AI工作台",
      "artifactName": "qihang-ai-desktop-${version}-setup.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
